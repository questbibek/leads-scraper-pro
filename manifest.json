{
    "manifest_version": 3,
    "name": "Google Maps Easy Scrape",
    "version": "2.2",
    "description": "Google Maps Easy Scrape with Persistent Sidebar by Quest Bibek",
    "permissions": ["activeTab", "storage"],
    "host_permissions": [
      "https://www.google.com/maps/*",
      "http://www.google.com/maps/*"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["*://www.google.com/maps/*"],
        "js": ["content.js"],
        "css": ["sidebar.css"],
        "run_at": "document_idle"
      }
    ],
  "icons": {
    "16": "map.png",
    "48": "map.png",
    "128": "map.png"
  }
  }
